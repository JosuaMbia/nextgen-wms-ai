# Firebase Configuration
# Get these from https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_bucket.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (for server-side)
# Download from Firebase Console > Project Settings > Service Accounts
FIREBASE_ADMIN_SDK='{"type":"service_account","project_id":"your_project_id"}'

# Shopify Integration
SHOPIFY_SHOP_URL=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret

# Office 365 / Microsoft Graph API
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=your_tenant_id

# Geopolitical Risk API (Optional)
GEOPOLITICAL_API_KEY=your_geopolitical_api_key
GEOPOLITICAL_API_URL=https://api.geopolitical-risks.com/v1

# Transporters API
DHL_API_KEY=your_dhl_api_key
UPS_API_KEY=your_ups_api_key
COLISSIMO_API_KEY=your_colissimo_api_key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Security
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Optional: AI Model Configuration
OPENAI_API_KEY=your_openai_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key
